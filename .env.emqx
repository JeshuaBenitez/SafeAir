# =============================================================================
# EMQX Environment Variables for Development
# Safe Air System - MQTT Broker
# =============================================================================

# Allow anonymous connections for development
EMQX_ALLOW_ANONYMOUS=true

# Log level
EMQX_LOG_LEVEL=info

# Disable IPv6 for dashboard
EMQX_DASHBOARD__LISTENERS__HTTP__INET6=false

# NOTE: Using default EMQX credentials for development
# In production, configure proper authentication
