# =============================================================================
# EMQX Environment Variables for Production
# Safe Air System - MQTT Broker
# =============================================================================

# ⚠️ IMPORTANTE: Cambia estos valores en producción

# =============================================================================
# SEGURIDAD
# =============================================================================

# Deshabilitar conexiones anónimas (requiere autenticación)
EMQX_ALLOW_ANONYMOUS=false

# Contraseña del usuario admin del dashboard
# ⚠️ CAMBIAR ESTA CONTRASEÑA en producción
# Ejemplo: MySecureP@ssw0rd2024!
EMQX_ADMIN_PASSWORD=change_me_in_production

# JWT Secret para el dashboard
# ⚠️ GENERAR aleatorio: jwt_secret=$(openssl rand -hex 32)
EMQX_JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars

# =============================================================================
# LOGGING
# =============================================================================

# Nivel de logs: debug, info, notice, warning, error, critical, alert, emergency
EMQX_LOG_LEVEL=warning

# =============================================================================
# API KEYS (para integración con sistemas externos)
# =============================================================================

# API Key para acceso programático
EMQX_API_KEY=safeair_api
# ⚠️ CAMBIAR en producción
EMQX_API_SECRET=change_me_api_secret

# =============================================================================
# CONFIGURACIÓN ADICIONAL
# =============================================================================

# PUERTO TCP MQTT
EMQX_MQTT_PORT=1883

# PUERTO TLS/SSL MQTT
EMQX_MQTT_TLS_PORT=8883

# WEBSOCKET MQTT
EMQX_WS_PORT=8084

# WEBSOCKET SSL
EMQX_WSS_PORT=8083
