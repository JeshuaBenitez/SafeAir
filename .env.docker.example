# SafeAir local Docker Compose example
# Copy to .env for `docker compose up --build`, or run:
# docker compose --env-file .env.docker.example up --build

NODE_ENV=production
API_PREFIX=/api/v1
API_HOST=0.0.0.0
PORT=3000

CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://127.0.0.1:8080,http://frontend:80

TELEMETRY_API_KEY=replace-with-local-telemetry-key
JWT_SECRET=replace-with-local-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
AUTH_SKIP_OTP=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=safeair
DB_USER=postgres
DB_PASSWORD=1234567890
DB_LOGGING=false
DB_SYNC_ON_STARTUP=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

POSTGRES_DB=safeair
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-db-password

MQTT_URL=mqtt://mqtt:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=safeair-api-local
MQTT_TELEMETRY_TOPIC=safeair/+/telemetry
MQTT_ACTUATOR_STATE_TOPIC=safeair/+/actuator-state
MQTT_QOS=1

EMULATOR_MISSING_STRATEGY=reject
EMULATOR_AUTO_INSTANCE_NAME=SafeAir Auto Instance
EMULATOR_AUTO_ROOM_PREFIX=Room
EMULATOR_AUTO_CREATE_DEVICES=true

# Java emulator IDs for docker-compose emulator-java.
# Match these to the operator rooms you are testing.
SAFEAIR_EMULATOR_ID_1=EMU-U001-R001
SAFEAIR_EMULATOR_ID_2=EMU-U001-R002
SAFEAIR_EMULATOR_ID_3=EMU-U001-R003

# Leave SMTP_HOST empty to use Ethereal/fallback logs in local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SafeAir Security <security@safeair.local>"

# Frontend Docker/Nginx build arg. api:3000 is resolved inside Docker.
API_BASE_URL=api:3000
