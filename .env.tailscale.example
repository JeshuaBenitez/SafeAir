# SafeAir distributed Tailscale example
# Copy to the API machine's .env and replace secrets.

NODE_ENV=development
API_PREFIX=/api/v1
API_HOST=0.0.0.0
PORT=3000

CORS_ORIGINS=http://100.127.49.17:4200,http://localhost:4200,http://localhost:8080,http://127.0.0.1:8080

TELEMETRY_API_KEY=replace-with-telemetry-key
JWT_SECRET=replace-with-shared-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
AUTH_SKIP_OTP=false

DB_HOST=100.79.106.54
DB_PORT=5432
DB_NAME=safeair
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_LOGGING=false
DB_SYNC_ON_STARTUP=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

MQTT_URL=mqtt://100.79.106.54:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=safeair-api-100-66-40-85
MQTT_TELEMETRY_TOPIC=safeair/+/telemetry
MQTT_ACTUATOR_STATE_TOPIC=safeair/+/actuator-state
MQTT_QOS=1

EMULATOR_MISSING_STRATEGY=reject
EMULATOR_AUTO_INSTANCE_NAME=SafeAir Auto Instance
EMULATOR_AUTO_ROOM_PREFIX=Room
EMULATOR_AUTO_CREATE_DEVICES=true

# Java emulator IDs for the emulator machine.
# Set these to the emulatorExternalId values assigned to the operator's rooms.
SAFEAIR_EMULATOR_ID_1=EMU-U001-R001
SAFEAIR_EMULATOR_ID_2=EMU-U001-R002
SAFEAIR_EMULATOR_ID_3=EMU-U001-R003

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM="SafeAir Security <replace-with-smtp-user>"
