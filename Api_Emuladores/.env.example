# ============================================================================
# SafeAir Backend Configuration / Configuración del Backend SafeAir
# ============================================================================
# Development Environment Example / Ejemplo de Entorno de Desarrollo
# 
# For multi-device setup (3 laptops):
# - Set DB_HOST to the database laptop IP
# - Set BACKEND_BIND_HOST=0.0.0.0 to listen on all interfaces
# - Frontend will connect via http://BACKEND_IP:BACKEND_PORT
#
# Para configuración multi-dispositivo (3 laptops):
# - Configurar DB_HOST a la IP de la laptop de la base de datos
# - Configurar BACKEND_BIND_HOST=0.0.0.0 para escuchar en todas las interfaces
# - Frontend se conectará vía http://BACKEND_IP:BACKEND_PORT
# ============================================================================

# Environment / Ambiente
NODE_ENV=development

# Server Configuration / Configuración del Servidor
# Listen port / Puerto de escucha
PORT=3000
# Listen host/interface
# 0.0.0.0 = all interfaces (multi-device friendly)
# 127.0.0.1 = localhost only (default for single machine)
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT=3000

# API Configuration / Configuración de la API
API_PREFIX=/api/v1

# Security / Seguridad
# Telemetry API key for HTTP telemetry endpoints (optional, Phase 2+)
TELEMETRY_API_KEY=dev-telemetry-key
# JWT secret for authentication - MUST be strong in production
JWT_SECRET=replace-with-strong-secret-at-least-32-chars-dev-only
# JWT token expiration time
JWT_EXPIRES_IN=24h

# Database Configuration / Configuración de Base de Datos
# Single machine: 127.0.0.1
# Multi-device: IP of database laptop (e.g., 192.168.1.30)
DB_HOST=127.0.0.1
DB_PORT=6543
DB_NAME=safeair
DB_USER=postgres
DB_PASSWORD=postgres
# Enable query logging for debugging
DB_LOGGING=false
# Sync Sequelize models with database schema on startup
DB_SYNC_ON_STARTUP=true
# SSL configuration for database connection
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# MQTT Broker Configuration / Configuración del Broker MQTT
# Connection URL - support mqtt://, mqtts://, ws://, wss://
MQTT_URL=mqtt://localhost:1883
# MQTT broker credentials (leave empty if no auth required)
MQTT_USERNAME=
MQTT_PASSWORD=
# Client ID for this backend instance
MQTT_CLIENT_ID=safeair-api
# MQTT topic patterns for telemetry and actuator commands
MQTT_TELEMETRY_TOPIC=safeair/+/telemetry
MQTT_ACTUATOR_STATE_TOPIC=safeair/+/actuator-state
# QoS level: 0 (fire and forget), 1 (at least once), 2 (exactly once)
MQTT_QOS=1

# Emulator Auto-Provisioning / Auto-provisión de Emuladores
# Strategy for handling emulators not found in database
# - auto-provision: automatically create Room + Device entries
# - reject: return 404 for unknown emulators
EMULATOR_MISSING_STRATEGY=auto-provision
# Name for auto-provisioned instances
EMULATOR_AUTO_INSTANCE_NAME=SafeAir Auto Instance
# Prefix for auto-provisioned room names
EMULATOR_AUTO_ROOM_PREFIX=Room
# Automatically create Device entries alongside Room on first telemetry
EMULATOR_AUTO_CREATE_DEVICES=true
