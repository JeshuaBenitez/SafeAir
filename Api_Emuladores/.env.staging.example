NODE_ENV=production
PORT=10000
API_HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=https://replace-frontend-origin,http://replace-frontend-origin
TELEMETRY_API_KEY=replace-with-strong-telemetry-key
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=24h
AUTH_SKIP_OTP=false
DB_HOST=replace-db-host
DB_PORT=5432
DB_NAME=replace-db-name
DB_USER=replace-db-user
DB_PASSWORD=replace-db-password
DB_LOGGING=false
DB_SYNC_ON_STARTUP=true
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
MQTT_URL=replace-mqtt-url
MQTT_USERNAME=replace-mqtt-username
MQTT_PASSWORD=replace-mqtt-password
MQTT_CLIENT_ID=safeair-api-staging
MQTT_TELEMETRY_TOPIC=safeair/+/telemetry
MQTT_ACTUATOR_STATE_TOPIC=safeair/+/actuator-state
MQTT_QOS=1
EMULATOR_MISSING_STRATEGY=reject
EMULATOR_AUTO_INSTANCE_NAME=SafeAir Auto Instance
EMULATOR_AUTO_ROOM_PREFIX=Room
EMULATOR_AUTO_CREATE_DEVICES=true

# SMTP Configuration (required for Render to send real OTP emails)
# Gmail App Password example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM="SafeAir Security <replace-with-smtp-user>"
