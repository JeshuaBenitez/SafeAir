# Backend
NODE_ENV=production
API_PREFIX=/api/v1
TELEMETRY_API_KEY=dev-telemetry-key
JWT_SECRET=replace-with-strong-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
DB_NAME=safeair
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
DB_SYNC_ON_STARTUP=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=safeair-api
MQTT_TELEMETRY_TOPIC=safeair/+/telemetry
MQTT_ACTUATOR_STATE_TOPIC=safeair/+/actuator-state
MQTT_QOS=1
EMULATOR_MISSING_STRATEGY=auto-provision
EMULATOR_AUTO_INSTANCE_NAME=SafeAir Auto Instance
EMULATOR_AUTO_ROOM_PREFIX=Room
EMULATOR_AUTO_CREATE_DEVICES=true

# Postgres (Compose)
POSTGRES_DB=safeair
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SMTP Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jesuaeder.moshi2004@gmail.com
SMTP_PASS=yakyfeixiagzhqaj
SMTP_FROM="SafeAir Security <security@safeair.io>"
