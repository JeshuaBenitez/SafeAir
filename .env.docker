# =============================================
# SafeAir - Docker Compose Local Configuration
# =============================================
# Este archivo es para desarrollo local con Docker Compose
# Copiar a .env antes de ejecutar: cp .env.docker .env

# ----- MODO DEMO -----
# Establecer en "true" para omitir autenticación OTP en desarrollo
# El login será directo sin necesidad de código por correo
AUTH_SKIP_OTP=false

# ----- API Configuration -----
NODE_ENV=production
API_PREFIX=/api/v1
API_HOST=0.0.0.0  # Bind a todas las interfaces para permitir conexiones LAN
PORT=3000

# ----- CORS -----
# Lista de orígenes separados por coma para permitir conexiones desde otras laptops
# localhost:4200 (Angular dev)
# localhost:8080 (Docker frontend)
# 192.168.x.x:8080 (Frontend en otra laptop LAN)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://127.0.0.1:8080

# ----- Security -----
TELEMETRY_API_KEY=dev-telemetry-key
JWT_SECRET=replace-with-strong-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# ----- Database -----
DB_NAME=safeair
DB_HOST=db  # Nombre del servicio en docker-compose.yml
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres  # Cambiar para producción
DB_LOGGING=false
DB_SYNC_ON_STARTUP=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# ----- MQTT / EMQX -----
# Docker Compose: mqtt (nombre del servicio)
# LAN: 192.168.x.x:1883 (IP de la laptop con EMQX)
MQTT_URL=mqtt://mqtt:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=safeair-api
MQTT_TELEMETRY_TOPIC=safeair/+/telemetry
MQTT_ACTUATOR_STATE_TOPIC=safeair/+/actuator-state
MQTT_QOS=1

# ----- Emulator Strategy -----
EMULATOR_MISSING_STRATEGY=auto-provision
EMULATOR_AUTO_INSTANCE_NAME=SafeAir Auto Instance
EMULATOR_AUTO_ROOM_PREFIX=Room
EMULATOR_AUTO_CREATE_DEVICES=true

# ----- Postgres (para docker-compose.yml) -----
POSTGRES_DB=safeair
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres  # Cambiar para producción

# ----- SMTP (opcional) -----
# Si no se configura, el sistema usará modo fallback (OTP en logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SafeAir Security <security@safeair.io>"
